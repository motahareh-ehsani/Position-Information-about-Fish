# TRACKING FILE WRITER
# Saves position data to text files — one file per camera per 10-min batch
# Format: timestamp  frame  x  y  w  h  conf  state
# Files saved to: TRACKING_FOLDER/ip/date/HH-MM-SS.txt
# ─────────────────────────────────────────────────────────────

# file handles: ip → open file object
_track_files: dict[str, object] = {}
_track_lock  = threading.Lock()
_track_frame_counters: dict[str, int] = {ip: 0 for ip in CAMERA_IPS}

def _get_track_file(ip: str, batch_start: datetime.datetime):
    """Get or create the tracking text file for this camera + batch."""
    cam_folder = os.path.join(
        TRACKING_FOLDER, ip, batch_start.strftime("%Y-%m-%d"))
    os.makedirs(cam_folder, exist_ok=True)
    start_str = batch_start.strftime("%H-%M-%S")
    end_str   = (batch_start + datetime.timedelta(
                  seconds=VIDEO_DURATION)).strftime("%H-%M-%S")
    path = os.path.join(cam_folder, f"{start_str}-{end_str}_{ip}.txt")
    f = open(path, "w", encoding="utf-8")
    # Write header
    f.write("timestamp\tframe\tx\ty\tw\th\tconf\tstate\n")
    f.flush()
    return f

def write_tracking_row(ip: str, det, batch_start: datetime.datetime) -> None:
    """
    Called by TrackerService after each inference.
    Writes one row per frame to the tracking text file.
    Non-blocking — uses a lock only for the file dict.
    """
    with _track_lock:
        if ip not in _track_files or _track_files[ip] is None:
            return
        f = _track_files[ip]
        _track_frame_counters[ip] = _track_frame_counters.get(ip, 0) + 1
        frame_idx = _track_frame_counters[ip]

    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    if det is not None:
        row = (f"{ts}\t{frame_idx}\t"
               f"{det.x:.4f}\t{det.y:.4f}\t"
               f"{det.w:.4f}\t{det.h:.4f}\t"
               f"{det.conf:.3f}\tdetection\n")
    else:
        row = f"{ts}\t{frame_idx}\tNA\tNA\tNA\tNA\tNA\tno\n"

    try:
        f.write(row)
        f.flush()
    except Exception as e:
        print(f"[Tracking] Write error {ip}: {e}")

def open_tracking_files(active_cameras: list, batch_start: datetime.datetime) -> None:
    """Open one tracking file per active camera at batch start."""
    with _track_lock:
        for ip in active_cameras:
            # Close previous file if open
            old = _track_files.get(ip)
            if old:
                try: old.close()
                except: pass
            _track_files[ip]           = _get_track_file(ip, batch_start)
            _track_frame_counters[ip]  = 0
    print(f"[Tracking] Opened tracking files for {len(active_cameras)} cameras")

def close_tracking_files() -> None:
    """Close all open tracking files."""
    with _track_lock:
        for ip, f in _track_files.items():
            if f:
                try: f.close()
                except: pass
        _track_files.clear()


