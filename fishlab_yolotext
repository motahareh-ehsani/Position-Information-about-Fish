@app.route('/snap/<ip>')
def snapshot(ip):
    """Return latest annotated JPEG (with bounding box) for dashboard."""
    with annotated_lock:
        data = annotated_store.get(ip, ERROR_FRAME)
    return Response(data, mimetype='image/jpeg',
                    headers={'Cache-Control': 'no-cache'})

@app.route('/detections')
def detections():
    """Return latest detection per camera as JSON."""
    with detection_lock:
        result = {}
        for ip, det in detection_store.items():
            if det is not None:
                result[ip] = {
                    "x":     round(det.x, 4),
                    "y":     round(det.y, 4),
                    "w":     round(det.w, 4),
                    "h":     round(det.h, 4),
                    "conf":  round(det.conf, 3),
                    "state": det.state,
                }
            else:
                result[ip] = None
    return jsonify(result)

@app.route('/status')
def status():
    with status_lock:
        return jsonify(dict(camera_status))

@app.route('/videos')
def videos():
    result = []
    for root, dirs, files in os.walk(ROOT_FOLDER):
        for f in sorted(files, reverse=True):
            if f.endswith('.avi'):
                result.append({"name": f, "path": os.path.join(root, f)})
                if len(result) >= 200: break
    return jsonify(result)

@app.route('/download')
def download():
    path = freq.args.get('path','')
    if not path or not os.path.exists(path):
        abort(404)
    return send_file(path, as_attachment=True)

