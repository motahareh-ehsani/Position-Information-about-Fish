# ─────────────────────────────────────────────────────────────
# TRACKER SERVICE
# Bounded drop-oldest queue feeding inference workers
# Never blocks recording threads!
# ─────────────────────────────────────────────────────────────

@dataclass
class _Job:
    ip:    str
    frame: np.ndarray

class TrackerService:
    """
    Rotating inference queue — processes one frame per camera at a time.
    CPU-friendly: WORKERS inference threads, bounded queue drops old frames.
    """
    def __init__(self) -> None:
        self._backend  = None
        self._trackers: dict[str, SingleFishTracker] = {
            ip: SingleFishTracker() for ip in CAMERA_IPS
        }
        self._cond     = threading.Condition()
        self._queue: deque[_Job] = deque()
        self._running  = True
        self._workers  = [
            threading.Thread(target=self._worker,
                             name=f"track-{i}", daemon=True)
            for i in range(max(1, WORKERS))
        ]

    def start(self) -> None:
        """Load model and start worker threads."""
        try:
            self._backend = UltralyticsBackend(YOLO_MODEL_PATH)
            # warm up
            dummy = np.zeros((240, 320, 3), dtype=np.uint8)
            self._backend.detect(dummy)
            print("[YOLO] Warm-up done ✅")
        except Exception as e:
            print(f"[YOLO] Failed to load model: {e}")
            print("[YOLO] Dashboard will show raw frames without tracking")
            self._backend = None
        for w in self._workers:
            w.start()
        print(f"[YOLO] {WORKERS} worker thread(s) started")

    def submit(self, ip: str, frame: np.ndarray) -> None:
        """
        Submit a frame for inference. Never blocks.
        Drops the oldest frame if queue is full.
        """
        with self._cond:
            if not self._running:
                return
            # drop oldest if full
            while len(self._queue) >= QUEUE_SIZE * len(CAMERA_IPS):
                self._queue.popleft()
            self._queue.append(_Job(ip=ip, frame=frame))
            self._cond.notify()

    def _worker(self) -> None:
        while True:
            with self._cond:
                while self._running and not self._queue:
                    self._cond.wait(0.5)
                if not self._running and not self._queue:
                    return
                job = self._queue.popleft()
            self._process(job)

    def _process(self, job: _Job) -> None:
        ip    = job.ip
        frame = job.frame.copy()

        # Run detection
        if self._backend is None:
            candidates = []
        else:
            try:
                candidates = self._backend.detect(frame)
            except Exception as e:
                print(f"[YOLO] Inference error on {ip}: {e}")
                candidates = []

        # Associate with tracker
        tracker          = self._trackers[ip]
        chosen, state    = tracker.update(candidates)

        # Store detection result
        det = None
        if chosen is not None:
            det = Detection(
                x=chosen.x, y=chosen.y,
                w=chosen.w, h=chosen.h,
                conf=chosen.conf, state=state
            )
        with detection_lock:
            detection_store[ip] = det

        # Save position to tracking text file (non-blocking)
        write_tracking_row(ip, det, datetime.datetime.now())

        # Draw annotation on frame
        annotated = self._draw(frame, det, ip)
        _, buf = cv2.imencode('.jpg', annotated,
                              [cv2.IMWRITE_JPEG_QUALITY, 80])
        with annotated_lock:
            annotated_store[ip] = buf.tobytes()

    def _draw(self, frame: np.ndarray,
              det: Optional[Detection], ip: str) -> np.ndarray:
        """Draw bounding box + position on frame."""
        h, w = frame.shape[:2]

        if det is not None and det.state == "locked":
            # Convert normalised coords to pixels
            cx = int(det.x * w)
            cy = int(det.y * h)
            bw = int(det.w * w)
            bh = int(det.h * h)
            x1 = max(0, cx - bw // 2)
            y1 = max(0, cy - bh // 2)
            x2 = min(w, cx + bw // 2)
            y2 = min(h, cy + bh // 2)

            # Bounding box — bright green
            cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 100), 2)

            # Label with confidence
            label = f"Fish {det.conf:.0%}"
            cv2.putText(frame, label, (x1, max(y1 - 6, 10)),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.45,
                        (0, 255, 100), 1, cv2.LINE_AA)

            # Center dot
            cv2.circle(frame, (cx, cy), 4, (0, 255, 255), -1)

            # Position info bottom-left
            pos_label = f"x:{det.x:.2f} y:{det.y:.2f}"
            cv2.putText(frame, pos_label, (4, h - 6),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.38,
                        (0, 200, 200), 1, cv2.LINE_AA)
        else:
            # Not detected — show dim indicator
            cv2.putText(frame, "no", (4, h - 6),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.38,
                        (80, 80, 80), 1, cv2.LINE_AA)

        # Camera IP top-right
        cv2.putText(frame, ip.split(".")[-1], (w - 28, 14),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.38,
                    (60, 60, 60), 1, cv2.LINE_AA)
        return frame

    def stop(self) -> None:
        with self._cond:
            self._running = False
            self._cond.notify_all()
        for w in self._workers:
            w.join(timeout=2.0)
        if self._backend:
            self._backend.close()


