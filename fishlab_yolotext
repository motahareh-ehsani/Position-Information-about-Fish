@dataclass
class Candidate:
    """Raw detection in normalised (0-1) frame coordinates."""
    x: float
    y: float
    w: float
    h: float
    conf: float

@dataclass
class Detection:
    """Confirmed detection published to the dashboard."""
    x: float
    y: float
    w: float
    h: float
    conf: float
    state: str  # "locked" or "lost"


class SingleFishTracker:
    """
    Per-camera association: assumes ONE fish per aquarium.
    Uses position continuity to reject glare and reflections.
    """
    def __init__(self, max_jump: float = MAX_JUMP,
                 lost_after: int = LOST_AFTER) -> None:
        self._max_jump   = max_jump
        self._lost_after = lost_after
        self.last: Optional[Candidate] = None
        self.misses = 0

    def update(self, candidates: list[Candidate]) -> tuple[Optional[Candidate], str]:
        if not candidates:
            self.misses += 1
            if self.misses >= self._lost_after:
                self.last = None
                return None, "lost"
            # brief dropout — hold last position, don't flicker
            return (self.last, "locked") if self.last else (None, "lost")

        chosen = candidates[0]  # highest confidence first
        if self.last is not None:
            # prefer candidates closest to last known position
            near = [c for c in candidates
                    if math.hypot(c.x - self.last.x, c.y - self.last.y) <= self._max_jump]
            if near:
                chosen = min(near,
                             key=lambda c: math.hypot(c.x - self.last.x, c.y - self.last.y))
        self.last  = chosen
        self.misses = 0
        return chosen, "locked"

    def reset(self) -> None:
        self.last   = None
        self.misses = 0


class UltralyticsBackend:
    """Runs inference using your .pt model directly."""
    def __init__(self, model_path: str) -> None:
        from ultralytics import YOLO
        self._model = YOLO(model_path)
        self._lock  = threading.Lock()
        print(f"[YOLO] Model loaded: {model_path}")

    def detect(self, frame_bgr: np.ndarray) -> list[Candidate]:
        h, w = frame_bgr.shape[:2]
        with self._lock:
            res = self._model.predict(
                frame_bgr,
                imgsz=IMGSZ,
                conf=CONF_THRESHOLD,
                verbose=False,
            )[0]
        out: list[Candidate] = []
        for box in res.boxes[:TOP_K]:
            x1, y1, x2, y2 = (float(v) for v in box.xyxy[0])
            out.append(Candidate(
                x=((x1 + x2) / 2) / w,
                y=((y1 + y2) / 2) / h,
                w=(x2 - x1) / w,
                h=(y2 - y1) / h,
                conf=float(box.conf[0]),
            ))
        return out

    def close(self) -> None:
        self._model = None


